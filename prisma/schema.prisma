// 🛑 Novo ENUM para as roles
enum Role {
  CLIENTE
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // 🛑 Novo CAMPO role
  role          Role      @default(CLIENTE) 

  accounts      Account[]
  sessions      Session[]
}

